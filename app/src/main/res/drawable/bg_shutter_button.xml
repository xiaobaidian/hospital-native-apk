<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 白色圆盘底 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
    <!-- 主色快门圆环（内缩留白，形成相机快门观感） -->
    <item
        android:left="11dp"
        android:top="11dp"
        android:right="11dp"
        android:bottom="11dp">
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
