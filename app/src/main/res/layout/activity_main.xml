<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍照白闪反馈 -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0" />

    <!-- 左上角：数量 + 时间 标注（仿水印样式，实时预览即将烧录的内容） -->
    <LinearLayout
        android:id="@+id/hudWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_watermark_hud"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHudQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数量：1"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时间：--"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 右上角：打开系统文件管理器（跳到下载文件夹） -->
    <ImageButton
        android:id="@+id/btnOpenDownloads"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_dark"
        android:src="@drawable/ic_folder"
        android:tint="@color/white"
        android:scaleType="centerInside"
        android:padding="11dp"
        android:contentDescription="打开下载文件夹"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 缩略图条（点开看大图） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerThumbs"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/strip_bg"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel" />

    <!-- 底部控制面板（圆角悬浮 sheet，Material 3 风格） -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 数量步进（圆形图标按钮 + 大号数字，拇指可达） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数量"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:layout_marginEnd="14dp" />

            <ImageButton
                android:id="@+id/btnQtyMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_minus"
                android:tint="@color/on_surface"
                android:scaleType="centerInside"
                android:padding="13dp"
                android:contentDescription="减少数量" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnQtyPlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_plus"
                android:tint="@color/on_surface"
                android:scaleType="centerInside"
                android:padding="13dp"
                android:contentDescription="增加数量" />
        </LinearLayout>

        <!-- 操作行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="分享微信"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart"
                android:layout_marginEnd="12dp" />

            <!-- 圆形快门按钮（白底 + 主色圆环） -->
            <ImageButton
                android:id="@+id/fabShutter"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_shutter_button"
                android:elevation="8dp"
                android:contentDescription="拍照" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="保存"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 全屏预览（点缩略图查看带水印大图） -->
    <FrameLayout
        android:id="@+id/previewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <ImageButton
            android:id="@+id/btnClosePreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_circle_dark"
            android:src="@drawable/ic_close"
            android:tint="@color/white"
            android:contentDescription="关闭预览" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:text="删除这张"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:backgroundTint="@color/danger" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
