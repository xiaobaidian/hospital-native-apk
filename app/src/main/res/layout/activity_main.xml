<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍照白闪反馈 -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:alpha="0" />

    <!-- 顶部标题（极简 scrim，仿 Google 相机风格） -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_scrim"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:alpha="0.92" />
    </LinearLayout>

    <!-- 缩略图条（点开看大图） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerThumbs"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/strip_bg"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel" />

    <!-- 底部控制面板（圆角悬浮 sheet，Material 3 风格） -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 数量步进（圆形加减 + 大号数字，拇指可达） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数量"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:layout_marginEnd="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQtyMinus"
                style="@style/CircleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:contentDescription="减少数量" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQtyPlus"
                style="@style/CircleButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:contentDescription="增加数量" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数量：1"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:alpha="0.6" />
        </LinearLayout>

        <!-- 操作行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="分享微信"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="拍照"
                app:srcCompat="@drawable/ic_shutter"
                app:backgroundTint="@color/primary"
                app:tint="@color/white"
                app:elevation="8dp"
                app:maxImageSize="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="保存"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 全屏预览（点缩略图查看带水印大图） -->
    <FrameLayout
        android:id="@+id/previewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <ImageButton
            android:id="@+id/btnClosePreview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_circle_dark"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/white"
            android:contentDescription="关闭预览" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:text="删除这张"
            app:backgroundTint="@color/danger" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
